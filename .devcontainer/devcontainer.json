{
  "name": "NEXUS PHP + MariaDB",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "app",
  "workspaceFolder": "/workspaces/Nexus",
  "runServices": [
    "db"
  ],
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000, 3306],
  "portsAttributes": {
    "8000": {
      "label": "NEXUS PHP website",
      "onAutoForward": "openBrowser"
    },
    "3306": {
      "label": "NEXUS MariaDB"
    }
  },
  "postStartCommand": "pkill -f 'php -S 0.0.0.0:8000 -t public' || true; nohup php -S 0.0.0.0:8000 -t public >/tmp/nexus-php.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client"
      ]
    }
  }
}
